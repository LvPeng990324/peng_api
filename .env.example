# peng_api 配置示例：复制为 .env 后按需修改
# 优先级：命令行 flag > 环境变量 > .env 文件 > 内置默认值

# 监听地址（默认 :8080）
PENG_ADDR=:8080

# 管理员登录密码（必填；也可用 -admin-password flag 或 PENG_ADMIN_PASSWORD 环境变量）
PENG_ADMIN_PASSWORD=change-me

# SQLite 数据库文件路径（默认 ./peng.db）
# PENG_DB=./peng.db

# 请求日志保留天数（默认 30）
# PENG_LOG_RETENTION_DAYS=30

# 渠道连续失败多少次后自动禁用（默认 3）
# PENG_FAIL_THRESHOLD=3

# 非流式上游超时（秒，默认 300）
# PENG_REQUEST_TIMEOUT=300

# 上游连接超时（秒，默认 10）
# PENG_CONNECT_TIMEOUT=10

# 流式首字节超时（秒，默认 60）
# PENG_STREAM_FIRST_BYTE_TIMEOUT=60
